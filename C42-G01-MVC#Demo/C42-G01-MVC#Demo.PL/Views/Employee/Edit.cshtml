@model EmployeeViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1 class="mt-3">Edit @Model.Name Employee</h1>
<br />
<div asp-validation-summary="All"></div>
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <center>
            <img src="~/Files/Images/@Model.ImageFileName" class="rounded" width="100px" height="100px" />
            <input asp-for="ImageFileName" hidden />
        </center>
    </div>
    <partial name="PartialViews/_CreateEditPartialView" />
    <input type="submit" value="Save" class="btn btn-primary" /> |
    <a asp-action="Index" class="btn btn-light">Back To List</a>
</form>
@section ValidationScriptSection
{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}