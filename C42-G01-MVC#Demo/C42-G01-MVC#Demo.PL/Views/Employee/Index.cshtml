@model IEnumerable<EmployeeViewModel> 
@{
    ViewData["Title"] = "Index";
    string InputPlaceholder = "Search For Employee By Name";
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success alertToDisapear">
        @TempData["Message"]
    </div>    
}

<a class="btn btn-success" asp-action="Create">Create Employee</a>
<br />
@if (Model.Count() != 0)
{
    <h1 class="mt-3">All Employees</h1>
    <br />
    <partial name="_SearchBarPartialView" model="InputPlaceholder" />
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(E => E.Image)</td>
                <td>@Html.DisplayNameFor(E => E.Name)</td>
                <td>@Html.DisplayNameFor(E => E.Department)</td>
                <td>@Html.DisplayNameFor(E => E.Age)</td>
                <td>@Html.DisplayNameFor(E => E.Salary)</td>
                <td>@Html.DisplayNameFor(E => E.Address)</td>
                <td>@Html.DisplayNameFor(E => E.Email)</td>
                <td>@Html.DisplayNameFor(E => E.PhoneNumber)</td>
                <td>@Html.DisplayNameFor(E => E.HireDate)</td>
                <td>@Html.DisplayNameFor(E => E.IsActive)</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td><img src="~/Files/Images/@employee.ImageFileName" alt="@employee.Name Image" style="width:40px; height: 40px" class="rounded"/></td>
                    <td>@employee.Name</td>
                    <td>@Html.DisplayFor(E => employee.Department.Name)</td>
                    <td>@employee.Age</td>
                    <td>@Html.DisplayFor(E => employee.Salary)</td>
                    <td>@employee.Address</td>
                    <td>@Html.DisplayFor(E => employee.Email)</td>
                    <td>@employee.PhoneNumber</td>
                    <td>@employee.HireDate</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <i class="fa-solid fa-circle" style="color: green"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-circle" style="color: red"></i>
                        }
                    </td>
                    <partial name="_IconsPartialView" model="@employee.Id.ToString()" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-3 p-5 alert alert-warning">
        <Center>
            <h3>
                There Is No Employees.
            </h3>
        </Center>
    </div>
}

@section DissapearAfterFiveSecondSection
{
    <partial name="_DisapearScriptPartiialView" />
}