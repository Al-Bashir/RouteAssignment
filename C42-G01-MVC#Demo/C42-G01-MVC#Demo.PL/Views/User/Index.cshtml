@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success alertToDisapear">
        @TempData["Message"]
    </div>
}

@if (Model.Count() != 0)
{
    <h1 class="mt-3">All Users</h1>
    <br />
    <form asp-action="Index">
        <div class="form-group" style="display:flex; gap: 1rem">
            <input type="search" name="SearchValue" class="form-control" placeholder="Search For User By Email" required />
            <input type="submit" value="Search" class="btn btn-primary" />
        </div>
    </form>
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(U => U.Id)</td>
                <td>@Html.DisplayNameFor(U => U.FName)</td>
                <td>@Html.DisplayNameFor(U => U.LName)</td>
                <td>@Html.DisplayNameFor(U => U.Email)</td>
                <td>@Html.DisplayNameFor(U => U.PhoneNumber)</td>
                <td>@Html.DisplayNameFor(U => U.Roles)</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(E => user.Id)</td>
                    <td>@Html.DisplayFor(E => user.FName)</td>
                    <td>@Html.DisplayFor(E => user.LName)</td>
                    <td>@Html.DisplayFor(E => user.Email)</td>
                    <td>@Html.DisplayFor(E => user.PhoneNumber)</td>
                    <td>@Html.DisplayFor(E => user.Roles)</td>
                    <partial name="_IconsPartialView" model="@user.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-3 p-5 alert alert-warning">
        <Center>
            <h3>
                There Is No Users.
            </h3>
        </Center>
    </div>
}
@section DissapearAfterFiveSecondSection
{
    <partial name="_DisapearScriptPartiialView" />
}
