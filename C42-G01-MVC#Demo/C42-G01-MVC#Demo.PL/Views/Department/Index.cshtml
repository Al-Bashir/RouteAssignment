@model IEnumerable<Department>
@{
    ViewData["Title"] = "Departments";
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success alertToDisapear">
        @TempData["Message"]
    </div>    
}

<a class="btn btn-success" asp-action="Create">Create Department</a>
<br />
@if (Model.Count() != 0)
{
    <h1 class="mt-3">All Departments</h1>
    <br />
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(D => D.Code)</td>
                <td>@Html.DisplayNameFor(D => D.Name)</td>
                <td>@Html.DisplayNameFor(D => D.DateOfCreation)</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.DateOfCreation</td>
                    <partial name="_IconsPartialView" model="@department.Id.ToString()" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-3 p-5 alert alert-warning">
        <Center>
            <h3>
                There Is No Departments.
            </h3>
        </Center>
    </div>    
}

@section DissapearAfterFiveSecondSection
{
    <partial name="_DisapearScriptPartiialView" />
}