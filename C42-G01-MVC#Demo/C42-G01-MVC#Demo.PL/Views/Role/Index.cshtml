@model IEnumerable<IdentityRoleViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string InputPlaceholder = "Search For Role By Name";
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success alertToDisapear">
        @TempData["Message"]
    </div>
}

<a class="btn btn-success" asp-action="Create">Create Role</a>
<br />
@if (Model.Count() != 0)
{
    <h1 class="mt-3">All Users</h1>
    <br />
    <partial name="_SearchBarPartialView" model="InputPlaceholder" />
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>@Html.DisplayNameFor(R => R.Id)</td>
                <td>@Html.DisplayNameFor(R => R.Name)</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var Role in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(E => Role.Id)</td>
                    <td>@Html.DisplayFor(E => Role.Name)</td>
                    <partial name="_IconsPartialView" model="@Role.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-3 p-5 alert alert-warning">
        <Center>
            <h3>
                There Is No Roles.
            </h3>
        </Center>
    </div>
}
@section DissapearAfterFiveSecondSection
{
    <partial name="_DisapearScriptPartiialView" />
}
