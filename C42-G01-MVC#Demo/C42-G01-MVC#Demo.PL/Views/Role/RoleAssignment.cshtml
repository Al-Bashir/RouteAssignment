@model RoleUsersViewModel
@{
    ViewData["Title"] = "Role Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Users = Model.Users;
}

@if (TempData["Message"] is not null)
{
    <div class="alert alert-success alertToDisapear">
        @TempData["Message"]
    </div>
}

<div asp-validation-summary="All" ></div>
<br />
@if (Model.Users.Count() != 0)
{
    <h1 class="mt-3">@Model.Role.Name List</h1>
    <br />
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>User Id</td>
                <td>FullName</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var User in Model.Users)
            {
                <tr>
                    <td>@Html.DisplayFor(U => User.Id)</td>
                    <td>@Html.DisplayFor(U => User.FullName)</td>
                    <td>
                        <a asp-action="RemoveRoleFromUser" 
                        asp-route-id="@User.Id" 
                        asp-route-RoleName="@Model.Role.Name"
                           asp-route-RoleId="@Model.Role.Id">
                            <i class="fa-solid fa-user-xmark text-danger"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-3 p-5 alert alert-warning">
        <Center>
            <h3>
                There Is No Users For @Model.Role.Name Role.
            </h3>
            <br />
        </Center>
    </div>
}

<br />
<center>
    <a asp-action="AssignNewRoleToUser" asp-route-RoleName="@Model.Role.Name" class="btn btn-success btn-lg"> Assign User </a>
</center>

@section DissapearAfterFiveSecondSection
{
    <partial name="_DisapearScriptPartiialView" />
}

