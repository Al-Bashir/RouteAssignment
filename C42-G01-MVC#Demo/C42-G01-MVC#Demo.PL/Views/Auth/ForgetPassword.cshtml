@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>
<form asp-controller="Auth" asp-action="SendEmail" method="post">
	<div class="form-group">
		<input asp-for="Email" class="form-control" placeholder="Recovery Email Address" />
		<span asp-validation-for="Email" class="text-danger"></span>
	</div>
	<input type="submit" value="Reset Password">
</form>

@section ValidationScriptSection
{
	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}


